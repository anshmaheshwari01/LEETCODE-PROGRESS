METHOD-2)- OPTIMAL APPROACH- TWO POINTER
class Solution {
    public int[] sortedSquares(int[] nums) {
        int n= nums.length;
        int[] ans= new int[n];
        int i=0;
        int j=n-1;
        int p=n-1;
        while(i<=j){
            int L=nums[i]*nums[i];
            int R=nums[j]*nums[j];
            if(L>R){
                ans[p--]=L;
                i++;
            }
            else{
                ans[p--]=R;
                j--;
            }
            

        }
        return ans;
        
    }
}
TIME COMPLEXITY= O(N)
SPACE COMPLEXITY= O(1)
