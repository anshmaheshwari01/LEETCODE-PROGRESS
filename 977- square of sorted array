METHOD-1)- BRUTE FORCE APPROACH
import java.util.Arrays;

class Solution {
    public int[] sortedSquares(int[] nums) {

        for (int i = 0; i < nums.length; i++) {
            nums[i] = nums[i] * nums[i];
        }

        Arrays.sort(nums);

        return nums;
    }
}

OR 

import java.util.Arrays;

class Solution {
    public int[] sortedSquares(int[] nums) {

        int n = nums.length;
        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = nums[i] * nums[i];
        }

        Arrays.sort(arr);

        return arr;
    }
}

TIME COMPLEXITY-O(N^2)
SPACE COMPLEXITY- O(N) OR O(1)
