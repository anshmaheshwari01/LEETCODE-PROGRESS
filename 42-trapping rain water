METHOD-2)- optimal approach
class Solution {
    public int trap(int[] height) {
        int n= height.length;
        int totalwater=0;

        int leftMax=0;
        int rightMax=0;

        int start=0;
        int end= n-1;

        while(start<end){
            leftMax= Math.max(leftMax,height[start]);
            rightMax=Math.max(rightMax,height[end]);

            if(leftMax<rightMax){
                totalwater += leftMax - height[start];
                start++;
            }else{
                totalwater +=rightMax - height[end];
                end--;

            }
        }

        return totalwater;

        
    }
}
time-O(n)
space-(1)
